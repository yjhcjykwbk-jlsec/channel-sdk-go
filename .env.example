# Feishu/Lark app credentials. Keep real values only in .env.
APP_ID=
APP_SECRET=

# Required for P0 smoke E2E.
CHANNEL_E2E_RECEIVE_OPEN_ID=
CHANNEL_E2E_GROUP_CHAT_ID=
CHANNEL_E2E_MENTION_USER_OPEN_ID=
CHANNEL_E2E_DOC_TOKEN=

# Optional for full E2E policy and share-card coverage. Missing values skip
# their corresponding cases instead of failing the whole runner.
CHANNEL_E2E_ALLOWED_GROUP_CHAT_ID=
CHANNEL_E2E_BLOCKED_GROUP_CHAT_ID=
CHANNEL_E2E_ALLOWED_USER_OPEN_ID=
CHANNEL_E2E_BLOCKED_USER_OPEN_ID=
CHANNEL_E2E_SHARE_CHAT_ID=
CHANNEL_E2E_STICKER_FILE_KEY=

# Required for upload/download and media message coverage.
CHANNEL_E2E_IMAGE_JPG=./testdata/e2e/image.jpg
CHANNEL_E2E_IMAGE_PNG=./testdata/e2e/image.png
CHANNEL_E2E_IMAGE_GIF=./testdata/e2e/image.gif
CHANNEL_E2E_IMAGE_WEBP=./testdata/e2e/image.webp
CHANNEL_E2E_FILE_PDF=./testdata/e2e/file.pdf
CHANNEL_E2E_FILE_DOCX=./testdata/e2e/file.docx
CHANNEL_E2E_FILE_XLSX=./testdata/e2e/file.xlsx
CHANNEL_E2E_FILE_PPTX=./testdata/e2e/file.pptx
CHANNEL_E2E_AUDIO_OGG=./testdata/e2e/audio.ogg
CHANNEL_E2E_VIDEO_MP4=./testdata/e2e/video.mp4
CHANNEL_E2E_VIDEO_COVER_IMAGE=./testdata/e2e/video-cover.jpg

# Optional non-default environment endpoints.
CHANNEL_E2E_DOMAIN=
CHANNEL_E2E_OPEN_BASE_URL=
CHANNEL_E2E_WS_BASE_URL=

# Optional runner switches.
CHANNEL_E2E_DRY_RUN=
CHANNEL_E2E_SKIP_AUTO=
CHANNEL_E2E_MANUAL=
CHANNEL_E2E_ENABLE_POLICY=
CHANNEL_E2E_ENABLE_BOT_ADDED=
CHANNEL_E2E_WAIT_SECONDS=180
CHANNEL_E2E_REQUEST_TIMEOUT_SECONDS=15
